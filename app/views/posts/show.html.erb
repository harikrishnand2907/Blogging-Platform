<div class="container mt-4">
  <h1 class="mb-3"><%= @post.title %></h1>

  <% if notice %>
    <p class="text-success"><%= notice %></p>
  <% end %>

  <p class="lead"><%= @post.content %></p>

  <% if user_signed_in? %>
    <%= link_to "Download as PDF", download_pdf_post_path(@post), class: "btn btn-primary mb-2" %>

    <% if @post.user == current_user %>
      <%= link_to "Edit this post", edit_post_path(@post), class: "btn btn-warning mb-2" %>
      <%= button_to "Destroy this post", @post, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger mb-2" %>
    <% end %>
  <% end %>

  <%= link_to "Back to Posts", posts_path, class: "btn btn-secondary mt-3" %>
</div>
