<div class="container py-5">
  <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 900px;">
    <div class="card-body p-5">
      <h1 class="card-title fw-bold mb-3 text-center text-primary">
        <%= @post.title %>
      </h1>
      <hr class="mb-4">

      <div class="card-text fs-5 text-secondary mb-4" style="line-height: 1.8;">
        <%= simple_format(@post.content) %>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-5">
        <p class="mb-0 text-muted fst-italic">
          Posted by <strong><%= @post.user.email %></strong>
        </p>

        <p class="mb-0 text-muted">
          <%= @post.created_at.strftime("%B %d, %Y at %I:%M %p") %>
        </p>
      </div>

      <hr class="my-4">

      <div class="d-flex justify-content-center gap-3">
        <%= link_to "Edit Post", edit_post_path(@post), class: "btn btn-outline-primary px-4" if @post.user == current_user %>
        <%= link_to "Back to Blog", posts_path, class: "btn btn-secondary px-4" %>
      </div>
    </div>
  </div>
</div>
