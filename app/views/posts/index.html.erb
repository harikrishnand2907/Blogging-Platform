<div class="container mt-4">
  <h1 class="mb-4">All Posts</h1>

  <% if notice %>
    <p class="text-success"><%= notice %></p>
  <% end %>

  <% if user_signed_in? %>
    <div class="mb-3">
      <%= form_with url: import_posts_path, multipart: true, local: true, class: "d-flex gap-2" do |f| %>
        <%= f.file_field :file, class: "form-control" %>
        <%= f.submit "Import CSV", class: "btn btn-primary" %>
      <% end %>
    </div>
    <%= link_to "New Post", new_post_path, class: "btn btn-success mb-3" %>
  <% end %>

  <div class="row">
    <% @posts.each do |post| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title"><%= link_to post.title, post %></h5>
            <p class="card-text"><%= truncate(post.content, length: 100) %></p>

            <% if user_signed_in? && post.user == current_user %>
              <%= link_to "Edit", edit_post_path(post), class: "btn btn-warning btn-sm" %>
              <%= button_to "Delete", post, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger btn-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
