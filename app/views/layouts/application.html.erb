<!DOCTYPE html>
<html>
  <head>
    <title>BlogApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
      .avatar {
        width: 35px;
        height: 35px;
        font-weight: bold;
        font-size: 1rem;
      }
    </style>
  </head>

  <body>
    
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <a class="navbar-brand" href="<%= root_path %>">BlogApp</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
           <% if user_signed_in? %>
  
  <li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
      <div class="avatar bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-2">
        <%= current_user.email[0].upcase %>
      </div>
      <span>Hello, <%= current_user.email.split('@').first %></span>
    </a>
    <ul class="dropdown-menu dropdown-menu-end">
      <li>
        <%= link_to "Edit Profile", edit_user_registration_path, class: "dropdown-item" %>
      </li>
      <li>
        <%= link_to "Logout", destroy_user_session_path,
            class: "dropdown-item",
            data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to logout?" } %>
      </li>
    </ul>
  </li>
<% else %>
  <li class="nav-item me-2">
    <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-outline-light" %>
  </li>
  <li class="nav-item">
    <%= link_to "Login", new_user_session_path, class: "btn btn-light" %>
  </li>
<% end %>

          </ul>
        </div>
      </div>
    </nav>

    
    <div class="container mb-4">
      <% flash.each do |key, message| %>
        <div class="alert alert-<%= key == "notice" ? "success" : "danger" %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
    </div>

    
    <div class="container">
      <%= yield %>
    </div>
  </body>
</html>
