<div class="container mt-5" style="max-width: 700px;">
  <div class="rounded-4" style="background-color: rgba(255, 255, 255, 0.97);">
    <div class="card-body p-5">
      <h2 class="text-center fw-bold mb-5">Edit Profile</h2>

      <% if resource.errors.any? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <ul class="mb-0">
            <% resource.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <div class="row g-4">
          
          <div class="col-12">
            <%= f.label :email, class: "form-label fw-semibold" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control shadow-sm" %>
          </div>

          
          <div class="col-12">
            <%= f.label :current_password, "Current Password", class: "form-label fw-semibold" %>
            <small class="text-muted d-block mb-1">(required)</small>
            <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control shadow-sm" %>
          </div>

          
          <div class="col-12">
            <%= f.label :password, "New Password", class: "form-label fw-semibold" %>
            <small class="text-muted d-block mb-1">(leave blank to keep current)</small>
            <%= f.password_field :password, autocomplete: "new-password", class: "form-control shadow-sm" %>
          </div>

          
          <div class="col-12">
            <%= f.label :password_confirmation, class: "form-label fw-semibold" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control shadow-sm" %>
          </div>
        </div>

        
        <div class="d-flex justify-content-center mt-5 gap-3">
          <%= f.submit "Update Profile", class: "btn btn-primary px-5 py-2" %>
          <%= link_to "Back", root_path, class: "btn btn-secondary px-5 py-2" %>
        </div>
      <% end %>

      <hr class="my-5">

      <!-- Cancel account section -->
      <div class="text-center">
        <h5 class="fw-bold text-danger mb-3">Cancel My Account</h5>
        <p class="text-muted mb-4">Unhappy? You can permanently delete your account.</p>
        <%= button_to "Delete Account", registration_path(resource_name),
            data: { confirm: "Are you sure? This cannot be undone." },
            method: :delete,
            class: "btn btn-outline-danger px-5 py-2" %>
      </div>
    </div>
  </div>
</div>
